{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "sortTailwindcss": {
    "stylesheet": "./src/styles.css"
  },
  "ignorePatterns": [
    "package-lock.json",
    ".changed-files.json",
    ".tooling-tests.json",
    "**/*.md",
    ".claude/**",
    ".agents/**",
    ".specify/**",
    "tests/fixtures/**"
  ]
}
