{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "docs/guidelines/code-quality/typescript.md",
    "docs/guidelines/code-quality/observability.md",
    "docs/guidelines/code-quality/control-flow.md",
    "docs/guidelines/code-quality/naming/functions.md",
    "docs/guidelines/code-quality/naming/variables.md",
    "docs/guidelines/frontend/react.md",
    "docs/guidelines/frontend/tailwind.md",
    "docs/guidelines/frontend/admin-ui.md",
    "docs/guidelines/frontend/accessibility.md"
  ],
  "permission": {
    "bash": {
      "*": "ask",
      "npm run *": "allow",
      "npm ci": "allow",
      "npx oxlint *": "allow",
      "npx oxfmt *": "allow",
      "npx vitest *": "allow",
      "npx tsc --noEmit *": "allow",
      "make": "allow",
      "make *": "allow",
      "docker compose *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git branch --show-current": "allow",
      "git ls-files *": "allow",
      ".specify/scripts/bash/*": "allow",
      "scripts/check-agents-sync.sh": "allow"
    },
    "read": {
      "*": "allow",
      "./.env": "deny",
      "./.env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny"
    },
    "webfetch": {
      "*": "ask",
      "https://v0-3-branch.zmk.dev/*": "allow",
      "https://zmk.dev/*": "allow",
      "https://github.com/*": "allow",
      "https://raw.githubusercontent.com/*": "allow"
    }
  }
}
