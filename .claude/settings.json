{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm ci)",
      "Bash(npx oxlint *)",
      "Bash(npx oxfmt *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(make)",
      "Bash(make *)",
      "Bash(docker compose *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "WebFetch(domain:zmk.dev)",
      "WebFetch(domain:v0-3-branch.zmk.dev)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  }
}
