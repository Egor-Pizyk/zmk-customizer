{
  "name": "zmk-customizer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests/unit tests/helpers vite.config.ts playwright.config.ts tests/e2e && oxlint --disable-typescript-plugin -c scripts/.oxlintrc.json scripts tests/tooling",
    "lint:fix": "oxlint --fix src tests/unit tests/helpers vite.config.ts playwright.config.ts tests/e2e && oxlint --fix --disable-typescript-plugin -c scripts/.oxlintrc.json scripts tests/tooling",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run check:architecture && npm run typecheck && npm run test:e2e:types && npm run lint && npm run format:check",
    "test:coverage": "vitest run --coverage",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:guidelines": "node --test tests/tooling/check-guidelines.test.mjs && node scripts/check-guidelines.mjs",
    "test:e2e": "playwright test",
    "test:e2e:types": "tsc --project tsconfig.e2e.json --noEmit",
    "check:mutation-runners": "node --test tests/tooling/mutation-runners.test.mjs",
    "test:mutations": "node scripts/check-test-mutations.mjs",
    "test:e2e:mutations": "node scripts/check-e2e-mutations.mjs",
    "check:release": "node --test tests/tooling/create-release.test.mjs",
    "check:changed": "node scripts/check-changes.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "check:static": "npm run check",
    "check:focus": "npm run test:unit:focus --",
    "test:unit": "npm run test && npm run test:tooling",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "test:unit:changed": "node scripts/check-changes.mjs --unit-only",
    "test:unit:focus": "node scripts/unit-test-focus.mjs"
  },
  "dependencies": {
    "@joint/core": "4.3.3",
    "fflate": "0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "8.0.7",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
