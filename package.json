{
  "name": "zmk-customizer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests/helpers vite.config.ts playwright.config.ts tests/e2e && oxlint --disable-typescript-plugin -c scripts/.oxlintrc.json scripts",
    "lint:fix": "oxlint --fix src tests/helpers vite.config.ts playwright.config.ts tests/e2e && oxlint --fix --disable-typescript-plugin -c scripts/.oxlintrc.json scripts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "sh scripts/check-agents-sync.sh && npm run check:architecture && npm run check:guidelines && npm run typecheck && npm run test:e2e:types && npm run lint && npm run format:check && npm run test:coverage",
    "test:coverage": "vitest run --coverage",
    "check:architecture": "node --test scripts/check-architecture.test.mjs && node scripts/check-architecture.mjs",
    "check:guidelines": "node --test scripts/check-guidelines.test.mjs && node scripts/check-guidelines.mjs",
    "test:e2e": "playwright test",
    "test:e2e:types": "tsc --project tsconfig.e2e.json --noEmit"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "jsdom": "^30.1.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
